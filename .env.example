# Supabase project credentials
# Get these from your Supabase project dashboard → Settings → API
#
# SECURITY NOTE: a real .env with live credentials was previously committed
# to this public repo's git history. Rotate the Supabase publishable key
# (Settings → API → regenerate) before relying on it, since the old value
# must be treated as compromised.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web Push (optional): generate with `npx web-push generate-vapid-keys`.
# Public key only — never put the private key here or in client env vars.
# See README "Web Push setup" for the matching Supabase secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
